# Never put production credentials or raw wallet numbers in source control.

# PostgreSQL / Supabase (server-side only)
DATABASE_URL=postgresql://kla_sync:change-me@localhost:5432/kla_sync

# Catalog onboarding API — server-to-server bearer token.
# Generate with: kla-sync catalog-api --print-dev-token
# Store the real value in the deployment secret manager; never commit it.
KLA_SYNC_CATALOG_API_TOKEN=

# Edge ingestion API — per-device HMAC secrets are provisioned through the
# deployment secret manager (one random value per edge node), never shared.
# The demo server accepts KLA_SYNC_DEVICE_SECRET for local testing only.
KLA_SYNC_DEVICE_SECRET=

# Redis hot fingerprint index for the matcher worker (production).
# REDIS_URL is used by the landmark index adapter when not using the in-memory
# reference index.

# Matching stores
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# Object storage for encrypted chunks and audit exports
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=kla-sync-captures
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Registry integration — use an approved URSB data-sharing endpoint only.
URSB_BASE_URL=
URSB_CLIENT_ID=
URSB_CLIENT_SECRET=

# Telecom integrations — store API credentials in a secret manager, not this file in production.
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# Encryption key reference, resolved by the deployment secret manager.
KMS_KEY_ID=
